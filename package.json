{
  "name": "@hypercarrier/rarebit",
  "version": "0.1.0-alpha.6",
  "description": "Sparse, provenance-bearing conversational evidence recovery for Pi sessions.",
  "license": "MIT",
  "author": "HyperCarrier contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deephbz/rarebit.git"
  },
  "homepage": "https://github.com/deephbz/rarebit#readme",
  "bugs": {
    "url": "https://github.com/deephbz/rarebit/issues"
  },
  "keywords": [
    "pi-package",
    "rarebit",
    "pi",
    "session"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "types": "./src/types.d.ts",
  "bin": {
    "rarebit": "./bin/rarebit.mjs",
    "piq": "./bin/piq.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e:summary-cache": "node scripts/e2e-summary-cache.mjs",
    "test:e2e:recall": "node scripts/e2e-recall-pi0842.mjs",
    "test:e2e:recall:pi083": "node scripts/e2e-recall-pi083.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "ajv": "^6.15.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/extension.mjs"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/index.mjs"
    },
    "./core": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-core.mjs"
    },
    "./session": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-session.mjs"
    },
    "./service": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-service.mjs"
    },
    "./artifact-state": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-artifact-state.mjs"
    },
    "./fork": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-fork.mjs"
    },
    "./fork-lineage": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-fork-lineage.mjs"
    },
    "./visual-language": {
      "types": "./src/types.d.ts",
      "import": "./src/rarebit-visual-language.mjs"
    },
    "./extension": {
      "types": "./src/types.d.ts",
      "import": "./src/extension.mjs"
    },
    "./types": "./src/types.d.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin/rarebit.mjs",
    "bin/piq.mjs",
    "src",
    "schemas",
    "scripts",
    "test",
    "README.md",
    "RUNBOOK.md",
    "VISUAL-LANGUAGE.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ]
}
